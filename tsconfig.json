{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["es2022"],
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["mocha", "chai", "node"]
  },
  "include": ["tests/**/*.ts", "packages/anchor-client/src/**/*.ts"],
  "exclude": ["node_modules", "packages/x402-svm"]
}

